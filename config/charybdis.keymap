#include <dt-bindings/zmk/mouse.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&lt {
    tapping-term-ms = <200>;
    flavor = "balanced";
    quick-tap-ms = <150>;
};

/ {
    keymap {
        compatible = "zmk,keymap";

        layer_0 {
            bindings = <
&kp ESC         &kp N1  &kp N2  &kp N3        &kp N4     &kp N5      &kp N6     &kp N7     &kp N8     &kp N9            &kp N0    &kp BACKSPACE
&kp TAB         &kp Q   &kp W   &kp F         &kp P      &kp B       &kp J      &kp L      &kp U      &kp Y             &kp SQT   &kp BSLH
&kp LEFT_SHIFT  &mt LGUI A   &mt LALT R   &mt LCTRL S         &mt LSHFT T      &kp G       &kp M      &mt RSHFT N      &mt RCTRL E      &mt RALT I             &mt RGUI O     &kp SQT
    &lt 3 Z          &mt RALT X   &kp C   &kp D         &kp V      &kp B       &kp K      &kp H      &kp COMMA  &mt RALT DOT      &lt 3 SLASH  &kp MINUS
                    &kp LEFT_WIN  &lt 4 SPACE  &lt 5 TAB       &lt 7 ENTER   &kp GRAVE
                                              &mkp MB1   &mkp MB2    &kp ENTER
            >;

            trackball-bindings = <&tmv_coarse>;
        };

        layer_1 {
            bindings = <
&trans          &trans      &trans      &trans         &trans      &trans        &trans        &trans         &trans         &trans               &trans      &trans
    &trans          &kp Q       &kp W       &kp E          &kp R       &kp T         &kp Y         &kp U          &kp I          &kp O                &kp P       &trans
    &trans          &mt LGUI A  &mt LALT S  &mt LCTRL D    &mt LSHFT F &kp G         &kp H         &mt RSHFT J    &mt RCTRL K    &mt RALT L           &mt RGUI SEMI &trans
    &trans          &lt 3 Z      &mt RALT X  &kp C          &kp V       &kp B         &kp N         &kp M          &kp COMMA      &mt RALT DOT         &lt 3 SLASH  &trans
                                &trans      &trans      &trans         &trans      &trans
                                              &trans      &trans         &trans
            >;

            trackball-bindings = <&tsl>;
        };

        layer_2 {
            bindings = <
&trans          &trans      &trans      &trans       &trans      &trans       &trans        &trans       &trans       &trans             &trans       &trans
    &trans          &kp Q       &kp W       &kp F        &kp P       &kp B        &kp J         &kp L        &kp U        &kp Y              &kp SQT      &trans
    &trans          &kp A       &kp R       &kp S        &kp T       &kp G        &kp M         &kp N        &kp E        &kp I              &kp O        &trans
    &trans          &kp Z       &kp X       &kp C        &kp D       &kp V        &kp K         &kp H        &kp COMMA    &kp DOT            &kp SLASH    &trans
                                &trans      &trans      &trans       &trans       &trans
                                              &trans      &trans       &trans
            >;

            trackball-bindings = <&tsl>;
        };

        layer_3 {
            bindings = <
&trans          &trans      &trans      &trans       &trans      &trans       &trans        &trans       &trans       &trans             &trans       &trans
    &trans          &none       &none       &none        &none       &none        &none         &none        &none        &none              &none        &trans
    &trans          &kp LGUI    &kp LALT    &kp LCTRL    &kp LSHFT   &none        &kp LEFT      &kp DOWN     &kp UP       &kp RIGHT          &none        &trans
    &trans          &none       &kp RALT    &mo 8        &mo 7       &bt BT_CLR   &bt BT_SEL 0  &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3       &bt BT_NXT   &trans
                                &trans      &trans      &trans       &trans       &trans
                                              &trans      &trans       &trans
            >;

            trackball-bindings = <&tsl>;
        };

        layer_4 {
            bindings = <
&trans          &trans      &trans      &trans       &trans      &trans       &trans          &trans        &trans            &trans             &trans       &trans
    &trans          &kp LGUI    &kp LALT    &kp LCTRL    &kp LSHFT   &none        &kp LEFT        &kp DOWN      &kp UP           &kp RIGHT          &kp CAPS     &trans
    &trans          &none       &kp RALT    &mo 7        &mo 4       &none        &kp HOME        &kp PG_DN     &kp PG_UP        &kp END            &kp INS      &trans
    &trans          &none       &none       &none        &none       &none        &kp ENTER       &kp BACKSPACE &kp DEL          &none              &none        &trans
                                &trans      &trans      &trans       &trans       &trans
                                              &trans      &trans       &trans
            >;

            trackball-bindings = <&tsl>;
        };

        layer_5 {
            bindings = <
&trans          &trans      &trans      &trans       &trans      &trans       &trans        &trans       &trans       &trans             &trans       &trans
&trans          &none       &none       &none        &none       &none        &kp LEFT      &kp DOWN     &kp UP       &kp RIGHT          &none        &trans
&trans          &kp LGUI    &kp LALT    &kp LCTRL    &kp LSHFT   &none        &kp C_PREV    &kp C_VOL_DN &kp C_VOL_UP &kp C_NEXT         &none        &trans
&trans          &none       &kp RALT    &mo 8        &mo 5       &none        &kp HOME      &kp PG_DN    &kp PG_UP    &kp END            &none        &trans
                                &trans      &trans      &trans       &trans       &trans
                                              &trans      &trans       &trans
            >;

            trackball-bindings = <&tsl>;
        };

        layer_6 {
            bindings = <
&trans          &trans      &trans      &trans       &trans      &trans       &trans         &trans        &trans        &trans             &trans       &trans
&trans          &kp LGUI    &kp LALT    &kp LCTRL    &kp LSHFT   &none        &kp C_PREV     &kp C_VOL_DN  &kp C_VOL_UP  &kp C_NEXT         &none        &trans
&trans          &none       &kp RALT    &mo 9        &mo 6       &none        &kp C_STOP     &kp C_PP      &kp C_MUTE    &none              &none        &trans
&trans          &none       &none       &none        &none       &none        &none          &none         &none         &none              &none        &trans
                                &trans      &trans      &trans       &trans       &trans
                                              &trans      &trans       &trans
            >;

            trackball-bindings = <&tsl>;
        };

        layer_7 {
            bindings = <
&trans          &trans      &trans      &trans       &trans      &trans       &trans          &trans       &trans       &trans             &trans       &trans
&trans          &kp GRAVE   &kp N1      &kp N2       &kp N3      &kp BSLH     &kp LEFT_BRACKET &kp N7      &kp N8       &kp N9             &kp RIGHT_BRACKET &trans
&trans          &kp LGUI    &kp LALT    &kp LCTRL    &kp LSHFT   &none        &kp EQUAL       &kp N4      &kp N5       &kp N6             &kp SEMI     &trans
&trans          &none       &kp RALT    &mo 4        &mo 7       &none        &kp BSLH        &kp N1      &kp N2       &kp N3             &kp GRAVE    &trans
                                &trans      &trans      &trans       &trans       &trans
                                              &trans      &trans       &trans
            >;

            trackball-bindings = <&tsl>;
        };

        layer_8 {
            bindings = <
&trans          &trans      &trans      &trans       &trans      &trans       &trans        &trans       &trans       &trans             &trans       &trans
&trans          &kp LEFT_BRACKET    &kp AMPS    &kp STAR     &kp LPAR    &kp RIGHT_BRACKET     &kp UNDER     &kp LPAR     &kp RPAR     &kp MINUS          &kp PLUS     &trans
&trans          &kp LGUI    &kp LALT    &kp LCTRL    &kp LSHFT   &none        &kp PLUS      &kp DLLR     &kp PRCNT    &kp CARET          &kp SEMI     &trans
&trans          &none       &kp RALT    &mo 9        &mo 8       &none        &kp PIPE      &kp EXCL     &kp AT       &kp HASH           &kp TILDE    &trans
                                &trans      &trans      &trans       &trans       &trans
                                              &trans      &trans       &trans
            >;

            trackball-bindings = <&tsl>;
        };

        layer_9 {
            bindings = <
&trans          &trans      &trans      &trans       &trans      &trans       &trans        &trans       &trans       &trans             &trans       &trans
&trans          &kp F12     &kp F7      &kp F8       &kp F9      &kp PSCRN    &kp C_PREV    &kp C_VOL_DN &kp C_VOL_UP &kp C_NEXT         &kp F10      &trans
&trans          &kp LGUI    &kp LALT    &kp LCTRL    &kp LSHFT   &none        &kp C_STOP    &kp C_PP     &kp C_MUTE   &kp PAUSE_BREAK    &kp F11      &trans
&trans          &none       &kp RALT    &mo 8        &mo 9       &none        &kp TAB       &kp SPACE    &kp K_APP    &none              &none        &trans
                                &trans      &trans      &trans       &trans       &trans
                                              &trans      &trans       &trans
            >;

            trackball-bindings = <&tsl>;
        };

        /* layer_6 {
            bindings = <
&none  &none   &none    &none   &none         &none         &kp N1         &none         &none     &none  &none   &to 0
&none  &none   &none    &none   &none         &none         &none         &none          &rgb_ug RGB_BRD &rgb_ug RGB_BRI  &rgb_ug RGB_EFF   &rgb_ug RGB_TOG
&none  &none   &none    &none   &none         &none         &none         &mkp LCLK     &mkp RCLK  &none  &none   &none
&none  &none   &none    &none   &bt BT_NXT  &bt BT_CLR    &none         &none         &none     &none  &none   &none
                                   &none         &none         &none         &none         &none
                                                 &none         &none         &none
            >;
          trackball-bindings = <&tsl>;
            
        };

       Mouse {
            bindings = <
&none        &none         &none         &none         &none      &none         &none       &none      &none         &none         &none         &none
&none        &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 3  &none      &bt BT_CLR    &bt BT_CLR  &none      &bt BT_SEL 2  &bt BT_SEL 1  &bt BT_SEL 0  &none
&none        &trans        &trans        &mkp MCLK     &trans     &none         &none       &trans     &mkp MCLK     &trans        &trans        &none
&bootloader  &trans        &mkp RCLK     &mo 4         &mkp LCLK  &mo 5         &mo 5       &mkp LCLK  &mo 4         &mkp RCLK     &trans        &bootloader
                                         &mo 5         &mkp LCLK  &mkp RCLK     &mkp RCLK   &mkp LCLK
                                                       &none      &trans        &trans
            >;

            
        };

        layer_4 {
            bindings = <
&trans  &trans  &trans     &trans     &trans     &trans       &trans     &trans     &trans     &trans     &trans  &trans
&trans  &trans  &trans     &trans     &trans     &trans       &trans     &trans     &trans     &trans     &trans  &trans
&trans  &trans  &trans     &mkp MCLK  &trans     &trans       &trans     &trans     &mkp MCLK  &trans     &trans  &trans
&trans  &trans  &mkp RCLK  &trans     &mkp LCLK  &trans       &trans     &mkp LCLK  &trans     &mkp RCLK  &trans  &trans
                           &trans     &mkp LCLK  &mkp RCLK    &mkp RCLK  &mkp LCLK
                                      &trans     &trans       &trans
            >;
                
                
                trackball-bindings = <&tsl>;
        };

        layer_5 {
            bindings = <
&trans  &trans  &trans     &trans     &trans     &trans       &trans     &trans     &trans     &trans     &trans  &trans
&trans  &trans  &trans     &trans     &trans     &trans       &trans     &trans     &trans     &trans     &trans  &trans
&trans  &trans  &trans     &mkp MCLK  &trans     &trans       &trans     &trans     &mkp MCLK  &trans     &trans  &trans
&trans  &trans  &mkp RCLK  &trans     &mkp LCLK  &trans       &trans     &mkp LCLK  &trans     &mkp RCLK  &trans  &trans
                           &trans     &mkp LCLK  &mkp RCLK    &mkp RCLK  &mkp LCLK
                                      &trans     &trans       &trans
            >;
                trackball-bindings = <&tmv_fine>;
                
        };*/
    };
};
